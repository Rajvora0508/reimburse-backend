# App
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Storage
DB_PATH=./database.sqlite
UPLOAD_DIR=./uploads

# Public base URL (optional, used to build absolute links to receipts in Sheet)
# Example when deployed: https://your-backend.onrender.com
PUBLIC_BASE_URL=http://localhost:4000

# Google Sheets
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Local dev uses a file:
GOOGLE_KEYFILE=./service-account.json
# On Render/production, paste the full JSON into GOOGLE_CREDENTIALS (do NOT upload the file):
# GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
